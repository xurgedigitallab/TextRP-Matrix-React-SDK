.mx_XRPLAuthCallback {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 400px;
    padding: 32px;
}

.mx_XRPLAuthCallback_content {
    text-align: center;
    max-width: 400px;
    width: 100%;
}

.mx_XRPLAuthCallback_header {
    margin-bottom: 24px;
    display: flex;
    justify-content: center;
    align-items: center;
}

.mx_XRPLAuthCallback_success,
.mx_XRPLAuthCallback_error {
    font-size: 48px;
    line-height: 1;
}

.mx_XRPLAuthCallback_title {
    margin: 0 0 16px 0;
    font-size: 24px;
    font-weight: 600;
    color: $primary-content;
}

.mx_XRPLAuthCallback_message {
    margin: 0 0 24px 0;
    font-size: 16px;
    color: $secondary-content;
    line-height: 1.4;
}

.mx_XRPLAuthCallback_actions {
    margin-top: 24px;
}

.mx_XRPLAuthCallback_retryButton {
    background: $accent;
    color: $accent-fg-color;
    border: none;
    border-radius: 8px;
    padding: 12px 24px;
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    
    &:hover {
        background: #0aa274; /* Darker shade of $accent (#0dbd8b) for hover state */
        transform: translateY(-1px);
    }
    
    &:active {
        transform: translateY(0);
    }
}

/* Responsive design */
@media (max-width: 480px) {
    .mx_XRPLAuthCallback {
        padding: 20px;
        min-height: 300px;
    }
    
    .mx_XRPLAuthCallback_title {
        font-size: 20px;
    }
    
    .mx_XRPLAuthCallback_message {
        font-size: 14px;
    }
}
